# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production (PostgreSQL):
#   DATABASE_URL="postgresql://user:password@localhost:5432/certpath?schema=public"
# Local zero-setup dev (SQLite, created by `npm run setup`):
#   DATABASE_URL="file:./dev.db"
#
# `npm run db:use:postgres` / `npm run db:use:sqlite` switch prisma/schema.prisma
# to the matching dialect. The data model is identical in both.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ byte random secret used to key the HMAC that derives session and
# password-reset token hashes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The platform still works without it, but every deployment then shares the
# same fallback key, so set it for anything real.
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production-0000000000"

# ---------------------------------------------------------------------------
# Email (password reset)
# ---------------------------------------------------------------------------
# Optional. Without a transport the reset link is written to the server log
# and returned in the API response (development only).
#
# Point EMAIL_WEBHOOK_URL at any service that accepts a JSON POST with
# { to, subject, text, html } to send real mail:
# EMAIL_WEBHOOK_URL="https://api.example-mail.com/v1/send"
# EMAIL_WEBHOOK_TOKEN="optional-bearer-token"

# ---------------------------------------------------------------------------
# AI Study Buddy
# ---------------------------------------------------------------------------
# Optional. Without a key the buddy uses the deterministic local tutor that
# answers from CertPath's own original content bank.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin, used only to build links in emails when the request's own
# origin cannot be trusted (a reverse proxy that does not forward the public
# hostname). The request origin is used by default, so a development server
# on a non-standard port still produces working links.
# NEXT_PUBLIC_APP_URL="https://certpath.example.com"
